{
    "name": "edrisaturay/filament-azure-socialite",
    "description": "Azure AD (Microsoft) Socialite authentication plugin for Filament v3 and v4",
    "keywords": [
        "filament",
        "laravel",
        "azure",
        "microsoft",
        "socialite",
        "oauth",
        "authentication"
    ],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.1",
        "filament/filament": "^3.0|^4.0",
        "laravel/framework": "^10.0|^11.0|^12.0",
        "laravel/socialite": "^5.0",
        "socialiteproviders/microsoft-azure": "^5.0",
        "spatie/laravel-package-tools": "^1.15"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "pestphp/pest": "^2.0|^3.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "EdrisaTuray\\FilamentAzureSocialite\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EdrisaTuray\\FilamentAzureSocialite\\Tests\\": "tests/",
            "App\\Models\\": "tests/Models/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EdrisaTuray\\FilamentAzureSocialite\\FilamentAzureSocialiteServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

